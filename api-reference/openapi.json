  "components": {
    "schemas": {
      "ChargeInfo": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "transactionReference": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "isSuccess": {
            "type": "boolean"
          },
          "errorDetails": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateDepositOrderRequest": {
        "required": [
          "amount",
          "description",
          "mobileNumber",
          "orderRef"
        ],
        "type": "object",
        "properties": {
          "mobileNumber": {
            "minLength": 1,
            "type": "string"
          },
          "amount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "walletProvider": {
            "$ref": "#/components/schemas/MobileWalletProvider"
          },
          "paymentMethod": {
            "$ref": "#/components/schemas/MobileWalletProvider"
          },
          "currency": {
            "type": "string",
            "nullable": true
          },
          "customerRef": {
            "$ref": "#/components/schemas/CustomerRefDto"
          },
          "orderRef": {
            "$ref": "#/components/schemas/OrderRefDto"
          },
          "description": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9 ]{1,200}$",
            "type": "string"
          },
          "successUrl": {
            "type": "string",
            "nullable": true,
            "deprecated": true
          },
          "cancelUrl": {
            "type": "string",
            "nullable": true,
            "deprecated": true
          },
          "intentType": {
            "type": "string",
            "nullable": true
          },
          "webhookUrl": {
            "maxLength": 2048,
            "type": "string",
            "nullable": true,
            "deprecated": true
          },
          "callbackUrl": {
            "maxLength": 2048,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateDepositOrderResponse": {
        "type": "object",
        "properties": {
          "paymentIntentId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string",
            "nullable": true
          },
          "merchantReference": {
            "type": "string",
            "nullable": true
          },
          "walletChargeInfo": {
            "$ref": "#/components/schemas/ChargeInfo"
          }
        },
        "additionalProperties": false
      },
      "CreateRefundRequestGateway": {
        "required": [
